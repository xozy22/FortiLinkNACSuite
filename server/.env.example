# Optionale Vorbelegung einer Standard-Verbindung.
# Ist FGT_HOST + FGT_API_KEY gesetzt, startet die App direkt verbunden.

FGT_HOST=fortigate.example.local
FGT_API_KEY=
FGT_VDOM=root
# TLS-Zertifikat pruefen (self-signed FortiGate: false)
FGT_VERIFY_TLS=false
# Schreibzugriff sperren – empfohlen fuer den ersten Kontakt mit Produktivsystemen
FGT_READ_ONLY=true

# Port des Backends. Bewusst nicht PORT – das gehoert im Dev-Betrieb dem Vite-Server.
FLNS_PORT=4100
# Verschluesselt gespeicherte API-Tokens mit AES-256-GCM. Ohne Secret Klartext.
FLNS_SECRET=
