# ---------------------------------------------------------------------------
# Zugang zur App selbst
# ---------------------------------------------------------------------------
# Passwort fuer die Oberflaeche. Ohne das laeuft die App offen – wer den Port
# erreicht, kann sich mit einem gespeicherten Profil verbinden und auf der
# FortiGate schreiben. Deshalb verweigert der Server den Start, wenn er auf
# einer nicht-lokalen Adresse lauschen soll und kein Passwort gesetzt ist.
FLNS_APP_PASSWORD=

# Adresse, auf der gelauscht wird. Default 127.0.0.1 (nur dieser Rechner).
# Im Container ist 0.0.0.0 noetig – dann aber mit FLNS_APP_PASSWORD.
FLNS_BIND=127.0.0.1

# Ausstieg fuer den Fall, dass eine eigene Authentifizierung davorsteht
# (Reverse-Proxy mit Basic Auth, SSO-Gateway o.ae.).
FLNS_ALLOW_ANONYMOUS=false

# Cookie nur ueber HTTPS senden. Hinter einem TLS-Proxy sinnvoll,
# bei reinem HTTP wuerde es das Cookie verschlucken.
FLNS_COOKIE_SECURE=false

# Verschluesselt gespeicherte API-Tokens (AES-256-GCM) und signiert die
# Sitzungs-Cookies. Ohne Secret werden Tokens im Klartext abgelegt und der
# Signierschluessel liegt in server/data/.session-key.
FLNS_SECRET=

# Port des Backends. Bewusst nicht PORT – das gehoert im Dev-Betrieb dem Vite-Server.
FLNS_PORT=4100

# ---------------------------------------------------------------------------
# Optionale Vorbelegung einer FortiGate-Verbindung
# ---------------------------------------------------------------------------
FGT_HOST=fortigate.example.local
FGT_API_KEY=
FGT_VDOM=root
# TLS-Zertifikat pruefen (self-signed FortiGate: false)
FGT_VERIFY_TLS=false
# Schreibzugriff sperren – empfohlen fuer den ersten Kontakt mit Produktivsystemen
FGT_READ_ONLY=true
